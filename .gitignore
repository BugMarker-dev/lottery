# ==================================================
# 以下是本项目（lottery）专属规则
# ==================================================

# ---------- Maven 构建输出 ----------
# 编译出来的 class、shade 后的 jar 都在这里，全部重新生成即可
target/

# ---------- 打包产物：整目录排除 ----------
# packaging/ 内含 JRE(rt.jar 60MB)、Android SDK(lld.exe 38MB)、
# 安装包 exe(26MB)、apk —— 合计 512MB，属于构建产物，不纳入版本控制
packaging/

